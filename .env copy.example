# ====== Claves para Boti Bot 🤖 (copia este archivo a .env) ======

# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys)
# Sin ella, Boti responde desde su banco local de preguntas frecuentes.
ANTHROPIC_API_KEY=

# Clave de ElevenLabs para la voz bonita (https://elevenlabs.io/app/settings/api-keys)
# Sin ella, Boti usa la voz del navegador (speechSynthesis).
ELEVENLABS_API_KEY=

# Opcional: id de voz de ElevenLabs (por defecto una voz cálida multilingüe)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Opcional: puerto del servidor (por defecto 8342)
# PORT=8342
